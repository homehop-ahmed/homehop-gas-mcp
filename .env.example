# Required: OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required: refresh token from running `npm run setup`
GOOGLE_REFRESH_TOKEN=

# Optional: bearer token claude.ai must send. Leave blank for "URL is the secret" mode.
MCP_SHARED_SECRET=

# Optional: port the server listens on (Railway sets this automatically)
PORT=3000
