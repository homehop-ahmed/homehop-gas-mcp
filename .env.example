# Required: OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required: refresh token from running `npm run setup`
GOOGLE_REFRESH_TOKEN=

# Optional: set to on to make /mcp demand sign-in (otherwise only /secure/mcp does)
AUTH_MODE=

# Optional: address of the HomeHop connector that checks sign-ins
HH_CONNECTOR_URL=

# Optional: this bridge's own public address (used in the sign-in challenge)
PUBLIC_URL=

# Optional: port the server listens on (Railway sets this automatically)
PORT=3000
